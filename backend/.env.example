# Local development overrides (Render sets these in the dashboard instead).
PORT=10000

# Exact comma-separated origins allowed to call the API.
CORS_ORIGINS=https://market-ai-tracker.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Auth0 access-token validation settings. These identify public Auth0 metadata;
# no Auth0 client secret is used by the SPA + bearer-token API architecture.
AUTH0_ISSUER=https://ragulg.us.auth0.com/
AUTH0_AUDIENCE=https://market-ai-tracker-api
AUTH0_JWKS_URL=https://ragulg.us.auth0.com/.well-known/jwks.json
